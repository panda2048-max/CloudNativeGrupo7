# Copiar como .env (gitignorado) junto a docker-compose.yml.
#   openssl rand -hex 32   -> para generar cada valor

# Secreto compartido por los nodos para formar el cluster (debe ser igual en ambos).
RABBITMQ_ERLANG_COOKIE=<cadena-aleatoria-larga>

# Usuario administrador del broker (management UI). Las aplicaciones usan
# usuarios propios, creados con crear-usuario.sh.
RABBITMQ_DEFAULT_USER=timetogame-ops
RABBITMQ_DEFAULT_PASS=<contrasena>
