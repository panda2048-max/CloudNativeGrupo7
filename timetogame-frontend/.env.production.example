# Copiar como .env.production (gitignorado) antes de `npm run build` para
# el despliegue en AWS. Reemplazar cada <ENTRE_CORCHETES>.

# URL del stage de API Gateway (Fase 4 de la guia de despliegue), incluyendo
# el prefijo /api que espera el backend.
VITE_API_BASE_URL=https://<API_ID>.execute-api.<REGION>.amazonaws.com/prod/api

# Microsoft Entra ID (Azure AD) - mismo tenant/App registrations que en
# desarrollo, solo cambian las URLs de redirect a las de la EC2 del
# frontend (deben estar tambien agregadas en el App registration
# "timetogame-spa" > Authentication > Redirect URIs).
VITE_AZURE_TENANT_ID=<TENANT_ID>
VITE_AZURE_CLIENT_ID_SPA=<CLIENT_ID_SPA>
VITE_AZURE_REDIRECT_URI=http://<DNS_PUBLICO_FRONTEND>/callback
VITE_AZURE_POST_LOGOUT_REDIRECT_URI=http://<DNS_PUBLICO_FRONTEND>/
VITE_AZURE_API_SCOPE=api://<CLIENT_ID_API>/access_as_user
