# Copiar como .env.production. No contiene secretos (URLs publicas e IDs de
# una SPA, que de todas formas quedan visibles en el bundle). `npm run build`
# lo carga solo, por encima de .env: no hace falta copiarlo sobre .env, que
# debe quedar con los valores de desarrollo local. Reemplazar cada <ENTRE_CORCHETES>.

# URL del stage de API Gateway, incluyendo el prefijo /api que espera el backend.
VITE_API_BASE_URL=https://<API_ID>.execute-api.<REGION>.amazonaws.com/api
# Rutas /api/admin/* del mismo API Gateway, integradas con la EC2 del admin.
VITE_RABBIT_ADMIN_API_URL=https://<API_ID>.execute-api.<REGION>.amazonaws.com/api/admin

# Microsoft Entra ID (Azure AD) - mismo tenant/App registrations que en
# desarrollo local (estos 3 valores NO cambian entre ambientes). Solo
# cambian las URLs de redirect, que deben agregarse tambien en el App
# registration "timetogame-spa" > Authentication > Redirect URIs (ademas
# de las de localhost, no en reemplazo).
VITE_AZURE_TENANT_ID=e199e31e-ed32-476b-983e-152fa84d6507
VITE_AZURE_CLIENT_ID_SPA=13efd1cf-69eb-46d7-a431-bb34ceb7607f
VITE_AZURE_REDIRECT_URI=http://<DNS_PUBLICO_FRONTEND>/callback
VITE_AZURE_POST_LOGOUT_REDIRECT_URI=http://<DNS_PUBLICO_FRONTEND>/
VITE_AZURE_API_SCOPE=api://3aea2387-eabd-41de-87da-1503cf447475/access_as_user
