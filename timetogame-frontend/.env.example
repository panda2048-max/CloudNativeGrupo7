# URL base del backend. Cambiar este valor (o apuntar a un API Manager/
# Gateway) es lo unico necesario para cambiar de ambiente.
VITE_API_BASE_URL=http://localhost:8000/api

# Identity Provider (Keycloak realm "timetogame"). client_id de un cliente
# publico SPA: no es secreto, se ve igual en el bundle del navegador.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/timetogame
VITE_OIDC_CLIENT_ID=timetogame-spa
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
